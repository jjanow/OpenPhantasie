<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenPhantasie.Client</RootNamespace>
    <!-- s174: a local build is 0.0.0-dev and never updates itself; CI sets the release's version (-p:Version=1.2.3). -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    <!-- The player's program file: OpenPhantasie(.exe). -->
    <AssemblyName>OpenPhantasie</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- s174: where the self-updater looks for releases (owner/name on GitHub); CI may pass another. -->
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" Condition="'$(UpdateRepository)' != ''" />
    <AssemblyMetadata Include="UpdateRepository" Value="jjanow/OpenPhantasie" Condition="'$(UpdateRepository)' == ''" />
  </ItemGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenPhantasie.Core\OpenPhantasie.Core.csproj" />
    <ProjectReference Include="..\OpenPhantasie.Data\OpenPhantasie.Data.csproj" />
    <ProjectReference Include="..\OpenPhantasie.Importer\OpenPhantasie.Importer.csproj" />
  </ItemGroup>
</Project>
